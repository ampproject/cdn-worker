{
  "name": "amp-cdn-worker",
  "version": "1.0.0",
  "description": "Cloudflare Worker code for the AMP runtime CDN",
  "main": "dist/worker.mjs",
  "scripts": {
    "build": "node ./esbuild.js",
    "format": "prettier --write  '*.{json,js}' 'src/**/*.{js,ts}' 'test/**/*.{js,ts}'",
    "lint": "eslint --max-warnings=0 src && prettier --check '*.{json,js}' 'src/**/*.{js,ts}' 'test/**/*.{js,ts}' && tsc --noEmit --pretty",
    "test": "jest --config test/jestconfig.json --verbose --silent"
  },
  "author": "The AMP HTML Authors",
  "license": "Apache-2.0",
  "dependencies": {
    "brotli-wasm": "2.0.1",
    "mime": "3.0.0",
    "worktop": "0.7.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260911.1",
    "@types/jest": "30.0.0",
    "@types/mime": "4.0.0",
    "@types/service-worker-mock": "2.0.4",
    "@typescript/lib-webworker": "npm:@cloudflare/workers-types",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@typescript-eslint/parser": "8.70.0",
    "esbuild": "0.25.2",
    "esbuild-plugin-ignore": "1.1.1",
    "esbuild-plugin-text-replace": "1.3.0",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-config-typescript": "3.0.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-google-camelcase": "0.0.2",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-prettier": "5.2.5",
    "eslint-plugin-sort-destructure-keys": "3.0.0",
    "eslint-plugin-tsdoc": "0.4.0",
    "jest": "30.5.1",
    "jest-fetch-mock": "4.2.0",
    "prettier": "3.5.3",
    "service-worker-mock": "2.0.5",
    "ts-jest": "29.3.1",
    "ts-loader": "9.5.2",
    "typescript": "7.0.2"
  }
}
